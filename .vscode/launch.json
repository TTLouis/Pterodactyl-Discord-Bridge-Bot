{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "KOOK API Smoke Test",
      "program": "${workspaceFolder}/scripts/kook-api-smoke-test.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "KOOK Gateway Smoke Test",
      "program": "${workspaceFolder}/scripts/kook-api-smoke-test.js",
      "args": ["--gateway"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "KOOK Status Channel Test",
      "program": "${workspaceFolder}/scripts/kook-status-message-test.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "KOOK Status Channel Preview",
      "program": "${workspaceFolder}/scripts/kook-status-message-test.js",
      "args": ["--dry-run"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "KOOK Channel Ops Test",
      "program": "${workspaceFolder}/scripts/kook-channel-ops-test.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "KOOK Live Status Test",
      "program": "${workspaceFolder}/scripts/kook-live-status-test.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "KOOK Channel Ops Test (Keep Messages)",
      "program": "${workspaceFolder}/scripts/kook-channel-ops-test.js",
      "args": ["--keep"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
