{
  "name": "discord-pterodactyl-bridge",
  "version": "0.2.1",
  "description": "Discord bot that syncs Pterodactyl server status and bridges game-server events into Discord channels.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "kook:smoke": "node scripts/kook-api-smoke-test.js",
    "kook:gateway": "node scripts/kook-api-smoke-test.js --gateway",
    "kook:status-test": "node scripts/kook-status-message-test.js",
    "kook:status-preview": "node scripts/kook-status-message-test.js --dry-run",
    "kook:status-live": "node scripts/kook-live-status-test.js",
    "kook:channel-ops": "node scripts/kook-channel-ops-test.js",
    "kook:channel-ops:keep": "node scripts/kook-channel-ops-test.js --keep",
    "setup": "node setup.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
