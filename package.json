{
  "name": "pterodactyl-platform-bridge",
  "version": "0.3.0-beta.3.3",
  "description": "Multi-platform bot that syncs Pterodactyl game-server status and events into chat platforms.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "validate-config": "node scripts/validate-config.js",
    "health-status": "node src/health-status.js",
    "kook:smoke": "node scripts/kook-api-smoke-test.js",
    "kook:gateway": "node scripts/kook-api-smoke-test.js --gateway",
    "kook:status-test": "node scripts/kook-status-message-test.js",
    "kook:status-preview": "node scripts/kook-status-message-test.js --dry-run",
    "kook:status-live": "node scripts/kook-live-status-test.js",
    "kook:channel-ops": "node scripts/kook-channel-ops-test.js",
    "kook:channel-ops:keep": "node scripts/kook-channel-ops-test.js --keep",
    "test": "node scripts/run-tests.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "ws": "^8.23.0"
  }
}
