DISCORD_TOKEN=your_discord_bot_token
CONFIG_PATH=./servers.json
STATE_PATH=./runtime-state.json
PANEL_UPDATE_INTERVAL_SECONDS=60
ACTIVE_PLAYER_UPDATE_INTERVAL_SECONDS=15

# Optional: override the Wings FQDN used for websocket console connections.
# REST API calls always use the Panel base URL configured in servers.json.
# Set PTERODACTYL_WINGS_FQDN when the Panel and Wings are on separate hosts.
PTERODACTYL_WINGS_FQDN=
# Force websocket scheme: "ws" or "wss". Leave empty to use whatever the Panel returns.
PTERODACTYL_WINGS_WS_SCHEME=wss
# Force websocket port. Leave empty to use the scheme default (443 for wss, 80 for ws).
PTERODACTYL_WINGS_WS_PORT=
