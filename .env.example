# Bootstrap Discord connection
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=

# Bootstrap Pterodactyl connection. These override matching values in the JSON config.
PTERODACTYL_PANEL_URL=
PTERODACTYL_CLIENT_API_KEY=

# Experimental relay is shelved by default until reliability work resumes.
GAME_CHAT_RELAY_ENABLED=false

# Optional KOOK bridge. When enabled, status panels and server-channel action messages are mirrored to KOOK.
KOOK_ENABLED=false
KOOK_TOKEN=your_kook_bot_token

CONFIG_PATH=./servers.json
STATE_PATH=./runtime-state.json
KOOK_STATE_PATH=./kook-runtime-state.json
# Liveness file touched after each poll pass; read by src/healthcheck.js.
HEARTBEAT_PATH=./heartbeat

# Optional: override the Wings FQDN used for websocket console connections.
# REST API calls always use the Panel base URL configured in servers.json.
# Set PTERODACTYL_WINGS_FQDN when the Panel and Wings are on separate hosts.
PTERODACTYL_WINGS_FQDN=
# Force websocket scheme: "ws" or "wss". Leave empty to use whatever the Panel returns.
PTERODACTYL_WINGS_WS_SCHEME=wss
# Force websocket port. Leave empty to use the scheme default (443 for wss, 80 for ws).
PTERODACTYL_WINGS_WS_PORT=

# Set to true while investigating console websocket disconnects. Logs connection
# timing, close codes/reasons, credential-cache age, heartbeat, and endpoint
# (without tokens or URL query parameters).
PTERODACTYL_CONSOLE_DIAGNOSTICS=false
